# /etc/heavnd/backup.env — permisos 600, dueño root. No lo subas a ningún repositorio.

# Clave PÚBLICA age con la que se cifran los volcados. Se genera en tu ordenador, no en el VPS:
#   age-keygen -o heavnd-backup.key        (imprime "Public key: age1…")
# Guarda heavnd-backup.key en el gestor de contraseñas. Sin ella las copias no se pueden leer.
AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Repositorio restic, en OTRO proveedor que el VPS. Ejemplos:
#   Backblaze B2 (API S3):  s3:https://s3.eu-central-003.backblazeb2.com/heavnd-backup
#   Hetzner Storage Box:    sftp:u123456@u123456.your-storagebox.de:heavnd-backup
RESTIC_REPOSITORY=
# Fichero con la contraseña del repositorio (una línea). Créalo con:
#   openssl rand -base64 32 > /etc/heavnd/restic-password && chmod 600 /etc/heavnd/restic-password
# y guarda también esa contraseña en el gestor: hace falta para restaurar en otra máquina.
RESTIC_PASSWORD_FILE=/etc/heavnd/restic-password

# Credenciales del almacenamiento (solo para S3/B2). Usa una clave limitada a ese bucket.
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# Aviso si la copia no se hace: URL de un check de healthchecks.io (o compatible). Opcional.
#HEALTHCHECK_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Valores por defecto; descomenta solo para cambiarlos.
#DATABASES="resolvd meald togethrd simplfd"
#UPLOAD_DIRS="/var/lib/resolvd/uploads /var/lib/togethrd/uploads"
#KEEP_DAILY=7
#KEEP_WEEKLY=4
#KEEP_MONTHLY=6
